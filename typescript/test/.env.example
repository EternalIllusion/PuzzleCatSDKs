# PuzzleCat SDK 本地测试配置
# 使用方式：复制本文件为 test/.env 后填写（test/.env 已被 gitignore，不会入库）

# PuzzleCat 站点根地址（必填）
PUZZLECAT_BASE_URL=https://puzzle.cat

# ---- OAuth 登录测试 ----
# 在 PuzzleCat 后台注册的应用 ID
PUZZLECAT_OAUTH_APP_ID=
# 应用密钥（仅本地测试服务器持有，勿提交仓库）
PUZZLECAT_OAUTH_SECRET=
# 回调地址，须与后台注册的完全一致；默认 http://localhost:3000/api/auth/callback
# PUZZLECAT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- OMI 外部管理测试 ----
# OMI 应用 ID（omi_ 开头）与密钥（创建/重置时仅显示一次）
PUZZLECAT_OMI_APP_ID=
PUZZLECAT_OMI_SECRET=

# 服务端口（默认 3000）
# PORT=3000
